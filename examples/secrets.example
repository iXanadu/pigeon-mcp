# Secrets — copy to `.keys` in the repo root (never commit that file).
# chmod 600 on the live secrets file.

# Google Cloud → OAuth clients
# Web application client — agent-initiated consent via https://<your-host>/oauth/callback
PIGEON_MCP_GOOGLE_WEB_CLIENT_ID=
PIGEON_MCP_GOOGLE_WEB_CLIENT_SECRET=
# Optional, stdio only — Desktop client for local accounts_add (loopback redirect). Most deployments leave these empty.
PIGEON_MCP_GOOGLE_CLIENT_ID=
PIGEON_MCP_GOOGLE_CLIENT_SECRET=

# Streamable HTTP bearer (gateway / Hand presents this token)
PIGEON_MCP_HTTP_BEARER_TOKEN=
