# Secrets — copy to `.keys` in the repo root (never commit that file).
# chmod 600 on the live secrets file.

# Google Cloud → OAuth clients
# Desktop client — local stdio accounts_add (loopback redirect)
GMAIL_MCP_GOOGLE_CLIENT_ID=
GMAIL_MCP_GOOGLE_CLIENT_SECRET=
# Web application client — Hand-initiated flow (https://…/oauth/callback)
GMAIL_MCP_GOOGLE_WEB_CLIENT_ID=
GMAIL_MCP_GOOGLE_WEB_CLIENT_SECRET=

# Streamable HTTP bearer (gateway / Hand presents this token)
GMAIL_MCP_HTTP_BEARER_TOKEN=
