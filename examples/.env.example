# Non-sensitive configuration — copy to .env in the repo root.
# Loaded automatically (with .keys) via pydantic-settings.

GMAIL_MCP_ENVIRONMENT=local
GMAIL_MCP_LOG_LEVEL=info

# Streamable HTTP (Hand / gateway). Bind loopback; put a proxy in front for remote access.
GMAIL_MCP_HTTP_HOST=127.0.0.1
GMAIL_MCP_HTTP_PORT=8879

# Attachment paths must resolve under these roots (symlinks are followed).
GMAIL_MCP_OUTBOX_ROOT=~/Outbox
GMAIL_MCP_DOWNLOAD_ROOT=~/Inbox

# OAuth token storage (created on first accounts_add).
# Local default is fine on a workstation. On a shared host, point this at the
# app directory your backup sweeps (files are named gmail-token-*.json, mode 0640).
GMAIL_MCP_TOKENS_DIR=~/.config/gmail-mcp/tokens

# Register this exact URI on your Google Desktop OAuth client
GMAIL_MCP_OAUTH_REDIRECT_URI=http://127.0.0.1:8767/oauth/callback
