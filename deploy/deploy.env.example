# Copy to deploy.env on the target host and edit. NO SECRETS HERE — this file
# only describes WHERE things are. Secrets live in the app's .keys.
#
# Every value below is host-specific. That is the point: the deploy script is
# generic and lives in the repo; the machine's shape lives here.

APP_DIR=/var/www/example.com/prod          # the git checkout the service runs from
UNIT=uvicorn_example_prod                  # systemd unit name
VENV=/usr/local/pyenv/versions/example     # virtualenv root (pyenv, not python -m venv)
SERVICE_USER=example_user                  # owns the checkout and runs the service

# The loopback origin the service listens on. NOTE: if this is literally
# 127.0.0.1 the MCP SDK enables DNS-rebinding protection with loopback-only
# allowed hosts and returns 421 to everything arriving through a reverse proxy.
# Bind another loopback address (127.0.0.2) or pass transport_security.
ORIGIN=http://127.0.0.2:8022

# Optional: static marketing pages
STATIC_SRC=web/marketing                   # relative to APP_DIR
STATIC_DST=/var/www/example-static
