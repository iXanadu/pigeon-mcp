<?xml version="1.0" encoding="UTF-8"?>
<!--
  pigeon-mcp LaunchAgent (macOS) — runs as the logged-in user.

  Install:
    cp launchd/com.pigeon-mcp.plist ~/Library/LaunchAgents/
    # Edit YOUR_USERNAME and python path if needed, then:
    ./scripts/start.sh

  Reverse-proxy 127.0.0.1:8879 for remote MCP clients.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pigeon-mcp</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/YOUR_USERNAME/.pyenv/versions/pigeon-mcp-3.13/bin/pigeon-mcp-http</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/YOUR_USERNAME/projects/pigeon-mcp</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/YOUR_USERNAME</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/YOUR_USERNAME/projects/pigeon-mcp/logs/pigeon-mcp.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/YOUR_USERNAME/projects/pigeon-mcp/logs/pigeon-mcp.err</string>
</dict>
</plist>
