<?xml version="1.0" encoding="UTF-8"?>
<!--
  pigeon-mcp LaunchAgent (macOS) — runs as the logged-in user.

  Install via ./scripts/start.sh (rewrites placeholders from this checkout).
  Reverse-proxy the HTTP bind for remote MCP clients.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pigeon-mcp</string>
    <key>ProgramArguments</key>
    <array>
        <string>__PIGEON_HTTP_BIN__</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__PIGEON_APP_DIR__</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>__PIGEON_HOME__</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__PIGEON_APP_DIR__/logs/pigeon-mcp.log</string>
    <key>StandardErrorPath</key>
    <string>__PIGEON_APP_DIR__/logs/pigeon-mcp.err</string>
</dict>
</plist>
