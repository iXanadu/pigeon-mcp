#!/usr/bin/env python3
"""stdio MCP proxy to a remote pigeon /mcp. Token from an identities file.

Install:  cp scripts/pigeon-mcp-proxy ~/.local/bin/pigeon-mcp && chmod 755 ~/.local/bin/pigeon-mcp

Provider configs carry PIGEON_IDENTITY only (never the bearer).
Resolution: PIGEON_IDENTITY -> ~/.config/pigeon-mcp/identities/<name>
Missing file is a hard error (never fall back to another harness).
PIGEON_TOKEN / PIGEON_MCP_URL in the process env override the file.

This is not the in-repo `pigeon-mcp` stdio server (venv entrypoint).
"""
from __future__ import annotations

import json
import os
import sys
import urllib.error
import urllib.request
from pathlib import Path

IDENT_DIR = Path.home() / ".config" / "pigeon-mcp" / "identities"


def _parse(path: Path) -> dict[str, str]:
    out: dict[str, str] = {}
    for line in path.read_text().splitlines():
        s = line.strip()
        if not s or s.startswith("#") or "=" not in s:
            continue
        k, v = s.split("=", 1)
        out[k.strip()] = v.strip()
    return out


def load_creds() -> tuple[str, str]:
    override = os.environ.get("PIGEON_TOKEN") or os.environ.get("PIGEON_API_TOKEN") or ""
    url_override = os.environ.get("PIGEON_MCP_URL") or ""
    selector = (os.environ.get("PIGEON_IDENTITY") or "").strip()
    token = override
    url = url_override or "https://pigeon.c52.com/mcp"
    if selector:
        path = IDENT_DIR / selector
        if not path.is_file():
            print(
                f"PIGEON_IDENTITY={selector!r} but {path} does not exist. "
                f"Create it (pigeon_api_token=..., chmod 600) or fix the selector.",
                file=sys.stderr,
            )
            sys.exit(2)
        data = _parse(path)
        token = (
            override
            or data.get("pigeon_api_token")
            or data.get("PIGEON_API_TOKEN")
            or ""
        )
        url = url_override or data.get("pigeon_mcp_url") or data.get("PIGEON_MCP_URL") or url
    if not token:
        print(
            "pigeon-mcp: no token. Set PIGEON_IDENTITY to a file under "
            f"{IDENT_DIR} or export PIGEON_TOKEN.",
            file=sys.stderr,
        )
        sys.exit(2)
    return token, url.rstrip("/")


def read_message() -> dict | None:
    header = sys.stdin.buffer.readline()
    if not header:
        return None
    if header.lower().startswith(b"content-length:"):
        length = int(header.split(b":", 1)[1].strip())
        while True:
            line = sys.stdin.buffer.readline()
            if line in (b"\r\n", b"\n", b""):
                break
        body = sys.stdin.buffer.read(length)
        return json.loads(body)
    line = header
    while not line.strip():
        line = sys.stdin.buffer.readline()
        if not line:
            return None
    return json.loads(line)


def write_message(obj: dict, *, lsp: bool) -> None:
    data = json.dumps(obj, separators=(",", ":")).encode()
    if lsp:
        sys.stdout.buffer.write(f"Content-Length: {len(data)}\r\n\r\n".encode())
        sys.stdout.buffer.write(data)
    else:
        sys.stdout.buffer.write(data + b"\n")
    sys.stdout.buffer.flush()


class PigeonRpc:
    def __init__(self, token: str, url: str) -> None:
        self.token = token
        self.url = url
        self.session_id = ""

    def call(self, payload: dict) -> dict:
        body = json.dumps(payload).encode()
        headers = {
            "Authorization": f"Bearer {self.token}",
            "Content-Type": "application/json",
            "Accept": "application/json, text/event-stream",
            "User-Agent": "pigeon-mcp-stdio/1.0",
        }
        if self.session_id:
            headers["Mcp-Session-Id"] = self.session_id
        req = urllib.request.Request(self.url, data=body, method="POST", headers=headers)
        try:
            with urllib.request.urlopen(req, timeout=120) as resp:
                sid = resp.headers.get("mcp-session-id") or resp.headers.get("Mcp-Session-Id")
                if sid:
                    self.session_id = sid
                raw = resp.read()
                ctype = (resp.headers.get("content-type") or "").lower()
        except urllib.error.HTTPError as exc:
            err = exc.read().decode("utf-8", "replace")[:500]
            return {
                "jsonrpc": "2.0",
                "id": payload.get("id"),
                "error": {"code": -32000, "message": f"HTTP {exc.code}: {err}"},
            }
        text = raw.decode("utf-8", "replace")
        if "text/event-stream" in ctype:
            for line in text.splitlines():
                if line.startswith("data:"):
                    text = line[5:].strip()
                    break
        try:
            return json.loads(text)
        except json.JSONDecodeError:
            return {
                "jsonrpc": "2.0",
                "id": payload.get("id"),
                "error": {"code": -32700, "message": "invalid JSON from Pigeon MCP"},
            }


def main() -> None:
    token, url = load_creds()
    rpc = PigeonRpc(token, url)
    lsp = True
    first = True
    while True:
        header_peek = sys.stdin.buffer.peek(16) if hasattr(sys.stdin.buffer, "peek") else b""
        if first and header_peek and not header_peek.lower().startswith(b"content-length"):
            lsp = False
        msg = read_message()
        if msg is None:
            return
        first = False
        if not msg.get("method"):
            continue
        result = rpc.call(msg)
        if msg.get("id") is None:
            continue
        write_message(result, lsp=lsp)


if __name__ == "__main__":
    main()
